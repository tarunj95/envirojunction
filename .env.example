# -----------------------------------------------------------------------------
# Auth0 Configuration
# -----------------------------------------------------------------------------
# Create an application of type "Regular Web Application" at https://manage.auth0.com/
#
# Allowed Callback URLs:
#   - http://localhost:9002/auth/callback
#   - https://www.envirojunction.com/auth/callback
# Allowed Logout URLs:
#   - http://localhost:9002
#   - https://www.envirojunction.com
# -----------------------------------------------------------------------------
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# A 32-byte secret used to encrypt the session cookie.
# Generate one using: openssl rand -hex 32
AUTH0_SECRET=your_generated_32_byte_secret

# Application base URL (port 9002 in dev; https://www.envirojunction.com in prod)
APP_BASE_URL=http://localhost:9002

# Client-side flags
NEXT_PUBLIC_AUTH0_ENABLED=true
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com

# -----------------------------------------------------------------------------
# Backend API Base URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://api.envirojunction.com

# -----------------------------------------------------------------------------
# Google OAuth Configuration (Google Identity Services)
# -----------------------------------------------------------------------------
# Obtain from https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins:
#   - http://localhost:9002
#   - https://www.envirojunction.com
#   - https://envirojunction.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com


